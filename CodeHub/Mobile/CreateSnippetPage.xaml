<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.CreateSnippetPage"
             BackgroundColor="#080B12">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- PRIMARY -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#3D6FE8"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <!-- GHOST -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#10141E"/>
                <Setter Property="TextColor" Value="#6B7694"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="BorderColor" Value="#1E2540"/>
                <Setter Property="BorderWidth" Value="1"/>
            </Style>

            <!-- LABEL -->
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="TextColor" Value="#3A4468"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="2.2"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="22,50,22,30">

            <!-- HEADER -->
            <VerticalStackLayout Spacing="4">
                <Label Text="NEW SNIPPET"
                       FontSize="11"
                       TextColor="#3D6FE8"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5"/>

                <Label Text="Create Snippet"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#DDE2F0"/>

                <Label Text="AI-powered code generation"
                       FontSize="13"
                       TextColor="#3A4468"/>
            </VerticalStackLayout>

            <!-- CLOSE -->
            <HorizontalStackLayout HorizontalOptions="End">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="#10141E"
                        Stroke="#1E2540"
                        StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="RemoveCreatePageClicked"/>
                    </Border.GestureRecognizers>

                    <Label Text="✕"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="#6B7694"/>
                </Border>
            </HorizontalStackLayout>

            <!-- TITLE -->
            <VerticalStackLayout Spacing="6">
                <Label Text="TITLE" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#0D1120"
                        Stroke="#1A2040"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Entry x:Name="TitleEntry"
                           Placeholder="e.g. Binary search"
                           TextColor="#DDE2F0"
                           PlaceholderColor="#3A4468"
                           BackgroundColor="Transparent"
                           Margin="14,10"
                           HeightRequest="48"/>
                </Border>
            </VerticalStackLayout>

            <!-- LANGUAGE -->
            <VerticalStackLayout Spacing="6">
                <Label Text="LANGUAGE" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#0D1120"
                        Stroke="#1A2040"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Picker x:Name="LanguagePicker"
                            Title="Select language..."
                            TextColor="#DDE2F0"
                            TitleColor="#3A4468"
                            BackgroundColor="Transparent"
                            Margin="12,10"
                            SelectedIndexChanged="OnLanguageChanged"/>
                </Border>
            </VerticalStackLayout>

            <!-- PROMPT -->
            <VerticalStackLayout Spacing="6">
                <Label Text="AI PROMPT" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#0D1120"
                        Stroke="#1A2040"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Entry x:Name="PromptEntry"
                           Placeholder="Describe what code you want..."
                           TextColor="#DDE2F0"
                           PlaceholderColor="#3A4468"
                           BackgroundColor="Transparent"
                           Margin="14,20"
                           HeightRequest="48"/>
                </Border>

                <Button Text="⚡ Generate with AI"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnGenerateClicked"
                        x:Name="GenerateButton"/>
            </VerticalStackLayout>

            <!-- CODE -->
            <VerticalStackLayout Spacing="6">
                <Label Text="CODE" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#0D1120"
                        Stroke="#1A2040"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Editor x:Name="ContentEditor"
                            HeightRequest="220"
                            FontFamily="monospace"
                            TextColor="#DDE2F0"
                            BackgroundColor="Transparent"
                            Margin="16"
                            AutoSize="TextChanges"/>
                </Border>
            </VerticalStackLayout>

            <!-- ACTIONS -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button Grid.Column="0"
                        Text="Discard"
                        Style="{StaticResource GhostButton}"
                        Clicked="RemoveCreatePageClicked"/>

                <Button Grid.Column="1"
                        Text="Save Snippet"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>