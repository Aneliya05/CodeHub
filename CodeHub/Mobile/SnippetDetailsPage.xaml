<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.SnippetDetailsPage"
             BackgroundColor="#080B12">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#3D6FE8"/>
                <Setter Property="TextColor" Value="#FFFFFF"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="CharacterSpacing" Value="0.3"/>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#10141E"/>
                <Setter Property="TextColor" Value="#6B7694"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="36"/>
                <Setter Property="WidthRequest" Value="36"/>
                <Setter Property="BorderColor" Value="#1E2540"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label x:Name="TitleLabel"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#DDE2F0"
                       LineBreakMode="TailTruncation"/>
                <Label x:Name="LanguageLabel"
                       FontSize="13"
                       TextColor="#3A4468"/>
            </VerticalStackLayout>

            <!-- Code container -->
            <Frame BackgroundColor="#0D1120"
                   BorderColor="#1A2040"
                   CornerRadius="12"
                   HasShadow="False"
                   Padding="0">
                <VerticalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="#161B22"/>
                    <WebView x:Name="ContentWebView" HeightRequest="300" BackgroundColor="Transparent"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Primary actions: copy / share -->
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="CopyButton"
                        Text="Copy"
                        Style="{StaticResource GhostButton}"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnCopyClicked"/>
                <Button x:Name="ShareButton"
                        Text="Share"
                        Style="{StaticResource GhostButton}"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnShareClicked"/>
            </HorizontalStackLayout>

            <!-- AI action -->
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="ExplainButton"
                        Text="Explain Code"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnExplainClicked"/>
            </HorizontalStackLayout>

            <!-- Explanation field -->
            <Label Text="EXPLANATION" FontSize="11" FontAttributes="Bold" TextColor="#3A4468"/>

            <Frame BackgroundColor="#0D1120"
                   BorderColor="#1A2040"
                   CornerRadius="10"
                   HasShadow="False"
                   Padding="0">
                <VerticalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="#161B22"/>
                    <ScrollView HeightRequest="180">
                        <Label x:Name="ExplanationLabel"
                               Text=""
                               FontSize="14"
                               FontFamily="monospace"
                               TextColor="#DDE2F0"
                               Margin="12"/>
                    </ScrollView>
                </VerticalStackLayout>
            </Frame>

            <Button x:Name="DeleteButton"
                    Text="Delete"
                    Style="{StaticResource GhostButton}"
                    Clicked="OnDeleteClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
