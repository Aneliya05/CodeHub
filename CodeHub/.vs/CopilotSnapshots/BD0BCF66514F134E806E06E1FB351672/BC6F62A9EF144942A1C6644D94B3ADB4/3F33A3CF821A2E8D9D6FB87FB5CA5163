<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.SnippetDetailsPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label x:Name="TitleLabel"
                       FontSize="24"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"/>
                <Label x:Name="LanguageLabel"
                       FontSize="13"
                       Opacity="0.8"/>
            </VerticalStackLayout>

            <!-- Code container -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                    <WebView x:Name="ContentWebView"
                             HeightRequest="300">
                    </WebView>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <!-- Primary actions: copy / share / edit -->
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="CopyButton"
                        Text="Copy"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnCopyClicked"/>
                <Button x:Name="ShareButton"
                        Text="Share"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnShareClicked"/>
            </HorizontalStackLayout>

            <!-- AI Actions -->
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="ExplainButton" Text="Explain Code" Clicked="OnExplainClicked" HorizontalOptions="FillAndExpand"/>
                <Button x:Name="OptimizeButton" Text="Optimize Code" Clicked="OnOptimizeClicked" HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

            <Button x:Name="AnalyzeButton"
                    Text="Generate Analysis"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                    Clicked="OnGenerateAnalysisClicked"/>

            <Button x:Name="DeleteButton"
                    Text="Delete"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                    Clicked="OnDeleteClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>