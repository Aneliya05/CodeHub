<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.CreateSnippetPage"
             BackgroundColor="#080B12">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- ── Entry Style ── -->
            <Style x:Key="InputStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="#E8EAF0"/>
                <Setter Property="PlaceholderColor" Value="#3A4158"/>
                <Setter Property="FontFamily" Value="monospace"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <!-- ── Primary Button ── -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#3D6FE8"/>
                <Setter Property="TextColor" Value="#FFFFFF"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="CharacterSpacing" Value="0.3"/>
            </Style>

            <!-- ── Ghost Button ── -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#10141E"/>
                <Setter Property="TextColor" Value="#6B7694"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="36"/>
                <Setter Property="WidthRequest" Value="36"/>
                <Setter Property="BorderColor" Value="#1E2540"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <!-- ── Section Label ── -->
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#3A4158"/>
                <Setter Property="CharacterSpacing" Value="1.6"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="#0A0C10">
        <VerticalStackLayout Spacing="0" Padding="0,0,0,48">

            <!-- ══════════ Header ══════════ -->
            <Grid ColumnDefinitions="*,Auto"
                  Padding="22,56,22,18"
                  BackgroundColor="#0A0C10">

                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="New Snippet"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#E8EAF0"/>
                    <Label Text="AI-powered code generation"
                           FontSize="13"
                           TextColor="#3A4158"/>
                </VerticalStackLayout>

                <!-- Close dot -->
                <Border Grid.Column="1"
                        BackgroundColor="#13161D"
                        Stroke="#1E2330"
                        StrokeThickness="1"
                        WidthRequest="38" HeightRequest="38"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19"/>
                    </Border.StrokeShape>
                    <Label Text="✕"
                           FontSize="13"
                           TextColor="#3A4158"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="RemoveCreatePageClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>

            <!-- Thin rule -->
            <BoxView HeightRequest="1" BackgroundColor="#111418" Margin="0,0,0,28"/>

            <!-- ══════════ Form ══════════ -->
            <VerticalStackLayout Spacing="22" Padding="22,0">

                <!-- ── Title ── -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="TITLE" Style="{StaticResource SectionLabel}"/>
                    <Border BackgroundColor="#13161D"
                            Stroke="#1E2330"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="TitleEntry"
                               Style="{StaticResource InputStyle}"
                               Placeholder="e.g.  Binary search in Python"
                               Margin="14,0"/>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Language ── -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="LANGUAGE" Style="{StaticResource SectionLabel}"/>
                    <Border BackgroundColor="#13161D"
                            Stroke="#1E2330"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Picker x:Name="LanguagePicker"
                                Title="Select language…"
                                TitleColor="#3A4158"
                                TextColor="#E8EAF0"
                                BackgroundColor="Transparent"
                                HeightRequest="50"
                                Margin="10,0"
                                SelectedIndexChanged="OnLanguageChanged"/>
                    </Border>
                </VerticalStackLayout>

                <!-- ── AI Prompt ── -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="AI PROMPT" Style="{StaticResource SectionLabel}"/>

                    <Border BackgroundColor="#13161D"
                            Stroke="#1E2330"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="PromptEntry"
                               Style="{StaticResource InputStyle}"
                               Placeholder="Describe what code you want…"
                               Margin="14,0"/>
                    </Border>

                    <Button x:Name="GenerateButton"
                            Style="{StaticResource PrimaryButton}"
                            Text="⚡  Generate with AI"
                            Clicked="OnGenerateClicked"/>
                </VerticalStackLayout>

                <!-- ── Code Editor ── -->
                <VerticalStackLayout Spacing="8">

                    <!-- Editor chrome row -->
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="CODE EDITOR"
                               Style="{StaticResource SectionLabel}"
                               VerticalOptions="Center"/>
                        <!-- macOS-style traffic lights -->
                        <HorizontalStackLayout Grid.Column="2"
                                               Spacing="7"
                                               VerticalOptions="Center">
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#FF5F57"/>
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#FEBC2E"/>
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#28C840"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <Border BackgroundColor="#0D1117"
                            Stroke="#1E2330"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <!-- Top rule inside editor -->
                            <BoxView HeightRequest="1" BackgroundColor="#161B22"/>
                            <Editor x:Name="ContentEditor"
                                    MinimumHeightRequest="200"
                                    FontFamily="monospace"
                                    FontSize="13"
                                    TextColor="#ABB2BF"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    Placeholder="// Generated code appears here…"
                                    PlaceholderColor="#21283A"
                                    Margin="16,14,16,14"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Action Buttons ── -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                    <Button Grid.Column="0"
                            Style="{StaticResource GhostButton}"
                            Text="Discard"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            Text="Save Snippet"
                            Clicked="OnSaveClicked"/>
                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
