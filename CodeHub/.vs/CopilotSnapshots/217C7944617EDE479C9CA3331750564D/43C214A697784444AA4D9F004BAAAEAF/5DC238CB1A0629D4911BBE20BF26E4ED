<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.CreateSnippetPage"
             Title=""
             BackgroundColor="#0A0C10">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="InputStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="#E8EAF0"/>
                <Setter Property="PlaceholderColor" Value="#9AA6C4"/>
                <Setter Property="FontFamily" Value="monospace"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HeightRequest" Value="48"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#4F8EF7"/>
                <Setter Property="TextColor" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="50"/>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#13161D"/>
                <Setter Property="TextColor" Value="#9AA6C4"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="BorderColor" Value="#252B38"/>
                <Setter Property="BorderWidth" Value="1"/>
            </Style>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#9AA6C4"/>
                <Setter Property="CharacterSpacing" Value="1.6"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="#0A0C10">
        <VerticalStackLayout Spacing="18" Padding="22,56,22,40">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="New Snippet"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#E8EAF0"/>
                    <Label Text="AI-powered code generation"
                           FontSize="13"
                           TextColor="#9AA6C4"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        BackgroundColor="#13161D"
                        Stroke="#1E2330"
                        StrokeThickness="1"
                        WidthRequest="38"
                        HeightRequest="38"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19"/>
                    </Border.StrokeShape>

                    <Label Text="✕"
                           FontSize="13"
                           TextColor="#9AA6C4"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Clicked="RemoveCreatePageClicked"/>
                </Border>

            </Grid>

            <BoxView HeightRequest="1"
                     BackgroundColor="#111418"/>

            <!-- TITLE -->
            <VerticalStackLayout Spacing="8">
                <Label Text="TITLE" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#13161D"
                        Stroke="#1E2330"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Entry x:Name="TitleEntry"
                           Style="{StaticResource InputStyle}"
                           Placeholder="e.g. Binary search in Python"
                           Margin="14,5"/>
                </Border>
            </VerticalStackLayout>

            <!-- LANGUAGE -->
            <VerticalStackLayout Spacing="8">
                <Label Text="LANGUAGE" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#13161D"
                        Stroke="#1E2330"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Picker x:Name="LanguagePicker"
                            Title="Select language…"
                            TitleColor="#9AA6C4"
                            TextColor="#E8EAF0"
                            BackgroundColor="Transparent"
                            HeightRequest="80"
                            Margin="10,10"
                            SelectedIndexChanged="OnLanguageChanged"/>
                </Border>
            </VerticalStackLayout>

            <!-- PROMPT -->
            <VerticalStackLayout Spacing="8">
                <Label Text="AI PROMPT" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#13161D"
                        Stroke="#1E2330"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Entry x:Name="PromptEntry"
                           Style="{StaticResource InputStyle}"
                           Placeholder="Describe what code you want…"
                           Margin="14,0"/>
                </Border>

                <Button x:Name="GenerateButton"
                        Style="{StaticResource PrimaryButton}"
                        Text="⚡  Generate with AI"
                        Clicked="OnGenerateClicked"/>
            </VerticalStackLayout>

            <!-- CODE EDITOR -->
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Label Grid.Column="0"
                           Text="CODE EDITOR"
                           Style="{StaticResource SectionLabel}"
                           VerticalOptions="Center"/>

                    <HorizontalStackLayout Grid.Column="2"
                                           Spacing="7"
                                           VerticalOptions="Center">
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="#FF5F57"/>
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="#FEBC2E"/>
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="#28C840"/>
                    </HorizontalStackLayout>

                </Grid>

                <Border BackgroundColor="#0D1117"
                        Stroke="#1E2330"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#161B22"/>

                        <Editor x:Name="ContentEditor"
                                MinimumHeightRequest="200"
                                FontFamily="monospace"
                                FontSize="13"
                                TextColor="#ABB2BF"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                Placeholder="// Generated code appears here…"
                                PlaceholderColor="#5E6B84"
                                Margin="16"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- PREVIEW -->
            <VerticalStackLayout Spacing="8">

                <Label Text="PREVIEW" Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="#0D1117"
                        Stroke="#1E2330"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <WebView x:Name="CodePreview"
                             HeightRequest="260"/>
                </Border>

            </VerticalStackLayout>

            <!-- ACTIONS -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button Grid.Column="0"
                        Style="{StaticResource GhostButton}"
                        Text="Discard"/>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Text="Save Snippet"
                        Clicked="OnSaveClicked"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>