<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.SnippetDetailsPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="22">

            <!-- Header (styled like MainPage) -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="DETAILS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           CharacterSpacing="2.5"/>
                    <Label x:Name="TitleLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           LineBreakMode="TailTruncation"/>
                    <Label x:Name="LanguageLabel"
                           FontSize="13"
                           Opacity="0.8"/>
                </VerticalStackLayout>

                <Frame Grid.Column="1"
                       WidthRequest="44"
                       HeightRequest="44"
                       CornerRadius="12"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                       BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                       Padding="0"
                       VerticalOptions="Center">
                    <Label Text="〈/〉"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>
            </Grid>

            <!-- Code container -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                    <WebView x:Name="ContentWebView" HeightRequest="320" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions row: Copy / Share -->
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="CopyButton" Text="Copy" HorizontalOptions="FillAndExpand"/>
                <Button x:Name="ShareButton" Text="Share" HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

            <!-- AI Actions row -->
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="ExplainButton" Text="Explain Code" HorizontalOptions="FillAndExpand" Clicked="OnExplainClicked"/>
                <Button x:Name="OptimizeButton" Text="Optimize Code" HorizontalOptions="FillAndExpand" Clicked="OnOptimizeClicked"/>
            </HorizontalStackLayout>

            <Button x:Name="AnalyzeButton" Text="Generate Analysis" Clicked="OnGenerateAnalysisClicked" />

            <Button x:Name="DeleteButton" Text="Delete" Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
